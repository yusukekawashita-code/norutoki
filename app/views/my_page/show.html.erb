<main class="my-page">
  <div class="my-page__inner">
    <div class="my-page__header">
      <p class="my-page__label">MY PAGE</p>
      <h1 class="my-page__title">マイページ</h1>
      <p class="my-page__welcome">
        <%= current_user.name %>さん、こんにちは！
      </p>
    </div>

    <section class="my-page__section">
      <h2 class="my-page__section-title">ユーザー情報</h2>

      <div class="my-page__user-card">
        <dl class="my-page__user-list">
          <div class="my-page__user-item">
            <dt>お名前</dt>
            <dd><%= current_user.name %></dd>
          </div>

          <div class="my-page__user-item">
            <dt>メールアドレス</dt>
            <dd><%= current_user.email %></dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="my-page__section">
      <h2 class="my-page__section-title">いつもの移動</h2>

      <div class="my-page__route-actions">
        <%= link_to "次の便を確認する",
                    next_departures_path,
                    class: "my-page__next-departures-link" %>

        <%= link_to "ルート一覧を見る",
                    usual_routes_path,
                    class: "my-page__routes-link" %>
      </div>

      <% if @usual_routes.any? %>
        <div class="my-page__route-list">
          <% @usual_routes.each do |usual_route| %>
            <div class="my-page__route-item">
              <p class="my-page__route-name">
                <%= usual_route.name %>
              </p>

              <p class="my-page__route-path">
                <%= usual_route.boarding_place %>
                →
                <%= usual_route.destination_place %>
              </p>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="my-page__empty">
          <p class="my-page__empty-title">
            いつもの移動はまだ登録されていません
          </p>

          <p class="my-page__empty-text">
            まずは普段利用するルートを登録してください。
          </p>
        </div>
      <% end %>
    </section>
  </div>
</main>