<h1>ログイン</h1>

<% if flash.now[:alert] %>
  <div>
    <%= flash.now[:alert] %>
  </div>
<% end %>

<%= form_with url: session_path do |form| %>
  <div>
    <label for="email">メールアドレス</label>
    <%= form.email_field :email %>
  </div>

  <div>
    <label for="password">パスワード</label>
    <%= form.password_field :password %>
  </div>

  <div>
    <%= form.submit "ログイン" %>
  </div>
<% end %>