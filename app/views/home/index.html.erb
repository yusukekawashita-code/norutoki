<main>
  <section class="top-hero">
    <div class="top-hero__inner">
      <p class="top-hero__service-name">Norutoki</p>

      <h1 class="top-hero__title">
        いつもの移動を、<br>
        検索しない。
      </h1>

      <p class="top-hero__description">
        Norutokiは、いつも利用するバスの時刻を登録しておくことで、<br>
        次に乗れる便をすぐに確認できるサービスです。
      </p>

      <% unless current_user %>
        <div class="top-hero__actions">
          <%= link_to "はじめて使う方",
                      new_user_path,
                      class: "top-hero__button" %>

          <%= link_to "ログイン",
                      new_session_path,
                      class: "top-hero__login" %>
        </div>
      <% end %>
    </div>
  </section>

  <% if current_user %>
    <section class="top-next-departures">
      <div class="top-next-departures__inner">
        <div class="top-next-departures__header">
          <p class="top-next-departures__label">NEXT BUS</p>
          <h2 class="top-next-departures__title">いつもの次の便</h2>
        </div>

        <% if @route_departures.any? %>
          <div class="top-next-departures__list">
            <% @route_departures.each do |route_departure| %>
              <% usual_route = route_departure[:usual_route] %>
              <% timetable = route_departure[:timetable] %>
              <% next_departure = route_departure[:next_departure] %>
              <% tomorrow_departure = route_departure[:tomorrow_departure] %>
              <% minutes_until_departure = route_departure[:minutes_until_departure] %>

              <article class="top-next-departures__card">
                <div class="top-next-departures__route">
                  <div class="top-next-departures__route-heading">
                    <h3 class="top-next-departures__route-name">
                      <%= usual_route.name %>
                    </h3>

                    <span class="top-next-departures__direction">
                      <%= usual_route.direction == UsualRoute::DIRECTIONS[:outbound] ? "行き" : "帰り" %>
                    </span>
                  </div>

                  <p class="top-next-departures__route-path">
                    <%= usual_route.boarding_place %>
                    <span>→</span>
                    <%= usual_route.destination_place %>
                  </p>
                </div>

                <div class="top-next-departures__result">
                  <% if timetable.nil? %>
                    <p class="top-next-departures__status">
                      時刻表が登録されていません
                    </p>

                  <% elsif next_departure.present? %>
                    <p class="top-next-departures__next-label">
                      次の出発
                    </p>

                    <p class="top-next-departures__time">
                      <%= next_departure.departure_time.strftime("%H:%M") %>
                    </p>

                    <p class="top-next-departures__countdown">
                      あと<%= minutes_until_departure %>分
                    </p>

                  <% elsif tomorrow_departure.present? %>
                    <p class="top-next-departures__next-label">
                      明日の最初の便
                    </p>

                    <p class="top-next-departures__time">
                      <%= tomorrow_departure.departure_time.strftime("%H:%M") %>
                    </p>

                  <% else %>
                    <p class="top-next-departures__status">
                      利用できる便が登録されていません
                    </p>
                  <% end %>
                </div>
              </article>
            <% end %>
          </div>

          <div class="top-next-departures__actions">
            <%= link_to "次の便を詳しく見る",
                        next_departures_path,
                        class: "top-next-departures__link" %>
          </div>
        <% else %>
          <div class="top-next-departures__empty">
            <p>いつもの移動はまだ登録されていません。</p>

            <%= link_to "ルートを登録する",
                        new_usual_route_path,
                        class: "top-next-departures__link" %>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="top-about">
    <div class="top-about__inner">
      <h2 class="top-about__title">
        いつものバスを、もっと簡単に。
      </h2>

      <p class="top-about__description">
        「行き方は知っている。でも、次が何時だったかは覚えていない。」
      </p>

      <p class="top-about__description">
        Norutokiなら、普段使うルートや時刻表を登録しておくだけ。
        毎回バス停や時刻表を検索することなく、次に利用できる便を確認できます。
      </p>
    </div>
  </section>
</main>