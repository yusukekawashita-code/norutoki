<main class="usual-routes">
  <div class="usual-routes__inner">
    <div class="usual-routes__header">
      <div>
        <p class="usual-routes__label">USUAL ROUTES</p>
        <h1 class="usual-routes__title">いつもの移動</h1>
      </div>

      <%= link_to "新しいルートを登録", new_usual_route_path, class: "usual-routes__new-link" %>
    </div>

    <% if @usual_routes.any? %>
      <div class="usual-routes__list">
        <% @usual_routes.each_with_index do |usual_route, index| %>
          <div class="usual-routes__card">
            <div class="usual-routes__card-content">
              <h2 class="usual-routes__name">
                <%= link_to usual_route.name, usual_route_path(usual_route), class: "usual-routes__name-link" %>
              </h2>

              <%= button_to toggle_favorite_usual_route_path(usual_route),
                            method: :patch,
                            class: ["usual-routes__favorite-button", ("is-favorite" if usual_route.favorite?)],
                            aria: { label: usual_route.favorite? ? "#{usual_route.name}のお気に入りを解除" : "#{usual_route.name}をお気に入りに設定" } do %>
                <span aria-hidden="true"><%= usual_route.favorite? ? "★" : "☆" %></span>
                <%= usual_route.favorite? ? "お気に入り" : "お気に入りに追加" %>
              <% end %>

              <div class="usual-routes__places">
                <span><%= usual_route.boarding_place %></span>
                <span class="usual-routes__arrow">→</span>
                <span><%= usual_route.destination_place %></span>
              </div>
            </div>

          <div class="usual-routes__order">
              <% if index.positive? %>
                <%= button_to "↑",
                              move_up_usual_route_path(usual_route),
                              method: :patch,
                              class: "usual-routes__order-button",
                              aria: { label: "#{usual_route.name}を上へ移動" } %>
              <% end %>

              <% if index < @usual_routes.size - 1 %>
                <%= button_to "↓",
                              move_down_usual_route_path(usual_route),
                              method: :patch,
                              class: "usual-routes__order-button",
                              aria: { label: "#{usual_route.name}を下へ移動" } %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="usual-routes__empty">
        <p>いつもの移動はまだ登録されていません</p>
        <%= link_to "最初のルートを登録する", new_usual_route_path %>
      </div>
    <% end %>
  </div>
</main>